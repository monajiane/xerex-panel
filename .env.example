APP_NAME="Xerex Panel"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=xerex_panel
DB_USERNAME=xerex
DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

# === Broadcasting (Laravel Reverb) ===
REVERB_APP_ID=xerex-panel
REVERB_APP_KEY=xerex-reverb-key
REVERB_APP_SECRET=xerex-reverb-secret
REVERB_HOST=0.0.0.0
REVERB_PORT=8080
REVERB_SCHEME=http

# === Pusher (alternative broadcaster) ===
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

CACHE_STORE=redis
CACHE_PREFIX=xerex_

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@xerex.local"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# === Xerex Panel specific configuration ===

# Master API (this panel) configuration
XEREX_MASTER_TOKEN=
XEREX_API_RATE_LIMIT=120
XEREX_API_RATE_DECAY=60

# Edge agent configuration
XEREX_EDGE_TOKEN_TTL=86400
XEREX_EDGE_HMAC_SECRET=
XEREX_EDGE_INSECURE_TLS=false
XEREX_EDGE_HEARTBEAT_TIMEOUT=120

# PowerDNS integration
XEREX_POWERDNS_API_URL=http://powerdns:8081
XEREX_POWERDNS_API_KEY=
XEREX_POWERDNS_DEFAULT_SOA="ns1.xerex.local hostmaster.xerex.local 1 10800 3600 604800 3600"

# Certbot / Let's Encrypt
XEREX_CERTBOT_EMAIL=admin@xerex.local
XEREX_CERTBOT_STAGING=false
XEREX_CERTBOT_WEBROOT=/var/www/letsencrypt

# Nginx / OpenResty control
XEREX_NGINX_RELOAD_CMD="docker exec xerex-nginx nginx -s reload"
XEREX_NGINX_CONFIG_DIR=/etc/nginx/conf.d
XEREX_OPENRESTY_ENABLED=false

# Health check
XEREX_HEALTH_CHECK_INTERVAL=30
XEREX_HEALTH_CHECK_TIMEOUT=5
XEREX_HEALTH_CHECK_FAIL_THRESHOLD=3
XEREX_HEALTH_CHECK_SUCCESS_THRESHOLD=2
XEREX_HEALTH_RECOVERY_THRESHOLD=2

# Failover
XEREX_FAILOVER_AUTO_PROMOTE=true

# Logging
XEREX_AUDIT_LOG_ENABLED=true
XEREX_TRAFFIC_LOG_RETENTION_DAYS=30
